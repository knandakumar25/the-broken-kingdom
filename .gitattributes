# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf
addons/godot-sqlite/bin/*.a filter=lfs diff=lfs merge=lfs -text
**/*.exe filter=lfs diff=lfs merge=lfs -text
**/*.x86_64 filter=lfs diff=lfs merge=lfs -text
**/*.apk filter=lfs diff=lfs merge=lfs -text
**/*.pck filter=lfs diff=lfs merge=lfs -text
**/*.dylib filter=lfs diff=lfs merge=lfs -text
**/*.so filter=lfs diff=lfs merge=lfs -text
**/*.dll filter=lfs diff=lfs merge=lfs -text
**/*.wasm filter=lfs diff=lfs merge=lfs -text
addons/godot-sqlite/bin/**/*.xcframework/**/*.a filter=lfs diff=lfs merge=lfs -text
